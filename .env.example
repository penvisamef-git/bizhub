# Copy to .env and fill in. Only variables starting with VITE_ reach the browser.
VITE_API_HOST=http://localhost:8086
VITE_API_AUTH_KEY=
VITE_LOGIN_STORAGE_KEY=bizhub_login

# Public website address printed in top-up card QR codes (e.g. https://bizhub.app). Empty = current browser address.
VITE_PUBLIC_SITE_URL=

# Phone sign-up (SMS code by Google Firebase). Firebase console → Project settings → General → Your apps → Web app.
# Also: Authentication → Sign-in method → Phone = on, and Authentication → Settings → Authorized domains
# must list your website (localhost is there by default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Firebase console → Authentication → Sign-in method: turn on "Google" and "Email/Password" → "Email link".
# SMS sign-up (phone code) costs money (Firebase billing / Blaze). Off unless set to 1:
VITE_SMS_SIGNUP=
